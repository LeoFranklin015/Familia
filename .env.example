# ── You provide these ────────────────────────────────────────────────
# Pimlico API key (dashboard.pimlico.io). Keep the sponsorship policy
# unrestricted (no address allowlist) — member addresses don't exist yet.
PIMLICO_API_KEY=

# Base Sepolia RPC URL (Alchemy/Infura/dRPC). The public https://sepolia.base.org
# works but rate-limits under a demo's load.
BASE_SEPOLIA_RPC_URL=

# Ethereum Sepolia RPC — only used by spikes/probe-aave-reserves.mjs, which
# documents why the app is not on that chain.
SEPOLIA_RPC_URL=

# Test-only deployer key with a little Sepolia ETH. Used ONLY to deploy
# the two contracts; the app itself never spends ETH.
DEPLOYER_PRIVATE_KEY=

# Optional: Pimlico sponsorship policy id. Empty = sponsor without a policy.
POLICY_ID=

# ── Deployed contracts (already live; redeploy with contracts/script) ─
DELEGATION_ADDRESS=0xd066936D3BbBa7E266572143bd30a9c7894A9EDb
SCOPED_SPEND_MANAGER_ADDRESS=0x6c1C15B3c5A77eBA21c3830f0FcD8D2b22635240

# Our USD₮ paymaster: deployed, funded and STAKED with the EntryPoint (staking
# is required — its validation reads the token's storage). Redeploy with
# contracts/script/DeployPaymaster.s.sol. Leave empty to run fully sponsored.
USDT_PAYMASTER_ADDRESS=0x8656b0E5CA10a506B42615C78Fa8F137F7f1Ea7B

# Where WDK reaches the ERC-7677 service in front of that paymaster. Defaults
# to this server's own /paymaster route.
# PAYMASTER_SERVICE_URL=http://localhost:8787/paymaster

# ── Notes (documented, not secrets) ──────────────────────────────────
# Chain: Base Sepolia (84532). Bundler+paymaster URL is derived from
# PIMLICO_API_KEY in code. The family money is USD₮ supplied to Aave V3's real
# pool; the parent holds Aave's own aUSDT. Pool/token/faucet addresses come
# from @bgd-labs/aave-address-book and are never pasted.
#   Aave POOL   0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27
#   USD₮        0x0a215D8ba66387DCA84B284D18c3B4ec3de6E54a
#   aUSD₮       0xcE3CAae5Ed17A7AafCEEbc897DE843fA6CC0c018
#   faucet      0xD9145b5F45Ad4519c7ACcD6E0A4A82e83bB8A6Dc  (unpermissioned)
# All operations are fully sponsored: neither Pimlico nor Candide prices gas in
# USD₮ on Base Sepolia. See the README for why that trade was made.
# PORT=8787 (optional override)
