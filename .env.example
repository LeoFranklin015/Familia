# ── You provide these ────────────────────────────────────────────────
# Pimlico API key (dashboard.pimlico.io). Keep the sponsorship policy
# unrestricted (no address allowlist) — member addresses don't exist yet.
PIMLICO_API_KEY=

# Sepolia RPC URL (Alchemy/Infura/dRPC).
SEPOLIA_RPC_URL=

# Test-only deployer key with a little Sepolia ETH. Used ONLY to deploy
# the two contracts; the app itself never spends ETH.
DEPLOYER_PRIVATE_KEY=

# Optional: Pimlico sponsorship policy id. Empty = sponsor without a policy.
POLICY_ID=

# ── Deployed contracts (already live; redeploy with contracts/script) ─
DELEGATION_ADDRESS=0xf13097db790cC5d9386352dCa5b046629e6517c9
SCOPED_SPEND_MANAGER_ADDRESS=0x8113a4a3c55Fb3a8fe93968c3897EEBfD2cf375f

# ── Notes (documented, not secrets) ──────────────────────────────────
# Chain: Sepolia (11155111). Bundler+paymaster URL is derived from
# PIMLICO_API_KEY in code. Pool asset is Aave V3 Sepolia EURS (the only
# viable stable reserve there — see README); pool/token addresses are
# imported from @bgd-labs/aave-address-book, never pasted.
