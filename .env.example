# ── You provide these ────────────────────────────────────────────────
# Pimlico API key (dashboard.pimlico.io). Keep the sponsorship policy
# unrestricted (no address allowlist) — member addresses don't exist yet.
PIMLICO_API_KEY=

# Sepolia RPC URL (Alchemy/Infura/dRPC).
SEPOLIA_RPC_URL=

# Test-only deployer key with a little Sepolia ETH. Used ONLY to deploy
# the two contracts; the app itself never spends ETH.
DEPLOYER_PRIVATE_KEY=

# Optional: Pimlico sponsorship policy id. Empty = sponsor without a policy.
POLICY_ID=

# ── Deployed contracts (already live; redeploy with contracts/script) ─
DELEGATION_ADDRESS=0xf13097db790cC5d9386352dCa5b046629e6517c9
SAVINGS_VAULT=0x5874F4c7E4D808a948F5F543b5C4F844Dc0D89F3
SCOPED_SPEND_MANAGER_ADDRESS=0xc18cC3F589493fB4B6f589b659AB87De82657De2

# ── Notes (documented, not secrets) ──────────────────────────────────
# Chain: Sepolia (11155111). Bundler+paymaster URL is derived from
# PIMLICO_API_KEY in code. The family money is USD₮ — Aave's Sepolia testnet
# USDT (0xaA8E23Fb…), imported from @bgd-labs/aave-address-book and minted
# from the Aave faucet. The savings leg is SAVINGS_VAULT rather than Aave
# itself because Aave Sepolia's USDT reserve is over its supply cap; the
# vault implements Aave's pool interface, so swapping it is config-only.
# Pimlico Sepolia USD₮ (gas token, parent token-mode): 0xd077A400968890Eacc75cdc901F0356c943e4fDb
# PORT=8787 (optional override)
