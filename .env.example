# ── You provide these ────────────────────────────────────────────────
# Pimlico API key (dashboard.pimlico.io). Make sure the sponsorship
# policy is UNRESTRICTED (no address allowlist) or attach no policy.
PIMLICO_API_KEY=

# Sepolia RPC URL (Alchemy/Infura/dRPC). Public RPC works but is flaky.
SEPOLIA_RPC_URL=

# Test-only deployer private key with ~0.05 Sepolia ETH.
# Used ONLY to deploy + verify Simple7702Account and ScopedSpendManager.
DEPLOYER_PRIVATE_KEY=

# Optional but wanted: lets forge verify the contracts on Etherscan
# so judges can click through. (etherscan.io/apidashboard)
ETHERSCAN_API_KEY=

# Optional: Pimlico sponsorship policy id. Leave empty to sponsor
# without a policy.
PIMLICO_SPONSORSHIP_POLICY_ID=

# ── I fill these in after deploying / derived ────────────────────────
BUNDLER_URL=https://api.pimlico.io/v2/11155111/rpc?apikey=${PIMLICO_API_KEY}
DELEGATION_ADDRESS=            # our deployed Simple7702Account (fallback: 0xe6Cae83BdE06E4c305530e199D7217f42808555B)
SCOPED_SPEND_MANAGER_ADDRESS=  # deployed ScopedSpendManager

# ── Fixed for Sepolia (documented, not secret) ───────────────────────
CHAIN_ID=11155111
PIMLICO_USDT_ADDRESS=0xd077A400968890Eacc75cdc901F0356c943e4fDb  # paymaster fee token
# Aave POOL / USDT / aUSDT / FAUCET are imported from @bgd-labs/aave-address-book in code, not env.
